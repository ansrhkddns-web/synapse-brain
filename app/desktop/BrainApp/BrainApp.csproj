<Project Sdk="Microsoft.NET.Sdk">

  <!-- SYNAPSE BRAIN 윈도우 프로그램: 자기 창 안에 화면(WebView2)을 넣고, 트레이에서 서버를 켜고 끈다 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SYNAPSE BRAIN</AssemblyName>
    <RootNamespace>SynapseBrain</RootNamespace>
    <ApplicationIcon>..\brain.ico</ApplicationIcon>
    <Product>SYNAPSE BRAIN</Product>
    <AssemblyTitle>SYNAPSE BRAIN</AssemblyTitle>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\brain.ico" LogicalName="brain.ico" />
  </ItemGroup>

</Project>
